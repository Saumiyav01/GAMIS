# Copy to backend/.env. This local synthetic setup uses no API keys or secrets.
GAMIS_ENV=development
# Development Ed25519 keys and runtime databases stay under the current user's home directory.
# Set GAMIS_DEV_KEY_DIR only to a directory outside the source tree.
# GAMIS_DEV_KEY_DIR=
#
# Ollama is the default local provider. For an offline deterministic run set GAMIS_LLM_PROVIDER=mock.
GAMIS_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
GAMIS_SUPERVISOR_MODEL=qwen2.5:7b
GAMIS_WORKER_MODEL=qwen2.5:7b
# Optional per-role model overrides (default to GAMIS_WORKER_MODEL).
# GAMIS_RESEARCH_MODEL=qwen2.5:7b
# GAMIS_ANALYSIS_MODEL=qwen2.5:7b
# GAMIS_VERIFICATION_MODEL=qwen2.5:7b
GAMIS_LLM_TIMEOUT=90
GAMIS_LLM_RETRIES=1
GAMIS_LLM_TEMPERATURE=0.2
GAMIS_LLM_CONTEXT_TOKENS=8192
GAMIS_WORKER_CONCURRENCY=3
#
# ACTION execution is disabled in the synthetic sample registry.
GAMIS_ACTION_ENABLED=false
